DATABASE_URL=postgresql+asyncpg://aihub:change-me@localhost:5432/aihub
POSTGRES_USER=aihub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aihub
CRAWLER_CONFIG=crawler/seeds.json

# Enable RAG after crawling/indexing. Every request still requires an institute session.
RAG_API_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-development-qdrant-key
QDRANT_COLLECTION=iiti_official
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
EMBEDDING_THREADS=2
CHUNK_TOKENS=700
CHUNK_OVERLAP=64
SEARCH_WINDOW_TOKENS=460
SEARCH_WINDOW_OVERLAP=32
RETRIEVAL_TOP_K=2
RETRIEVAL_MIN_SCORE=0.55
CONTEXT_MAX_CHARACTERS=24000
# Compose default. For a backend running directly on the host, use http://localhost:11434/v1.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=local
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=90
MAX_CONCURRENT_CHATS=4

# Phase 3 authentication. Generate a random secret and copy the same bridge secret into frontend/.env.local.
AUTH_ENABLED=false
AUTH_BRIDGE_SECRET=
GOOGLE_CLIENT_ID=
# Gmail OAuth read-only connection. Register this exact frontend callback URI
# in Google Cloud: http://localhost:3000/api/gmail/callback
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=
INSTITUTE_DOMAIN=iiti.ac.in
SESSION_HOURS=8
DEMO_LOGIN_ENABLED=false
# Registration requires SMTP; Google login does not.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# Optional generation cache. Start Compose with --profile cache.
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_TTL=300
REDIS_URL=redis://redis:6379/0

# Local English voice; the backend image needs a rebuild when enabled.
VOICE_ENABLED=false
VOICE_WHISPER_MODEL=base.en

# ---- Answer engine (grounded mode) ----
# grounded = query rewriting + hybrid (vector + keyword) search + reranking + cited answer + automatic checks.
# excerpt  = old behaviour (one verified quote, no synthesis).
ANSWER_MODE=grounded
ANSWER_CONTEXT_CHUNKS=6
QUERY_REWRITE_ENABLED=true
QUERY_VARIANTS=3
# Optional faster model just for rewriting questions (e.g. qwen2.5:3b-instruct while LLM_MODEL is 7b/14b).
LLM_REWRITE_MODEL=
HISTORY_TURNS=3
HYBRID_SEARCH_ENABLED=true
RERANK_ENABLED=true
# Xenova/ms-marco-MiniLM-L-12-v2 (120 MB, fast on CPU) or BAAI/bge-reranker-base (1 GB, more accurate, slower).
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
RERANK_MIN_SCORE=-4
GLOSSARY_PATH=sources/glossary.json
SOURCES_CONFIG=sources/sources.json
# Recommended for accuracy: a 7B+ instruct model, e.g. LLM_MODEL=qwen2.5:7b-instruct (pull it in Ollama first).


# ---- Auth helpers ----
# Development only: print registration / password-reset codes in the backend log instead of emailing.
EMAIL_DEV_MODE=false
# Gmail sender example (needs a Google "App password", not your normal password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=yourbot@gmail.com
# SMTP_PASSWORD=abcdabcdabcdabcd
# SMTP_FROM=            (blank = SMTP_USERNAME; Gmail rejects other From addresses)
# Behind the campus HTTP proxy? Lets Google certificate fetches use HTTPS_PROXY.
OUTBOUND_TRUST_ENV=false
# Credentials for database/API sources referenced in sources/sources.json
DIRECTORY_DB_DSN=
EVENTS_API_TOKEN=

# Optional Gemini general chat (server-side only, never put key in frontend code)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_GOOGLE_SEARCH=true
# Local Ollama on an 8 GB laptop may need more inference time
LLM_TIMEOUT_SECONDS=300
MAX_CONCURRENT_CHATS=1
