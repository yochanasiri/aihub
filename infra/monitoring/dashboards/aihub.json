{
  "uid": "aihub-overview",
  "title": "AIHUB overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "aihub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "h": 8,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(aihub_rag_requests_total{mode=\"chat\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Chat duration p95 (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "aihub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "h": 8,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aihub_rag_duration_seconds_bucket{mode=\"chat\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Cache hits per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "aihub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "h": 8,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aihub_rag_cache_hits_total[5m])) * 60",
          "legendFormat": "cache hits"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Backend scrape availability",
      "datasource": {
        "type": "prometheus",
        "uid": "aihub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "h": 8,
        "w": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"aihub\"}",
          "legendFormat": "backend"
        }
      ]
    }
  ]
}
